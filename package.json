{
  "name": "aoda-components",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @aoda/ui dev",
    "build": "pnpm --filter @aoda/ui build",
    "test": "pnpm --filter @aoda/ui test",
    "test:watch": "pnpm --filter @aoda/ui test:watch",
    "demo:dev": "pnpm --filter demo dev",
    "build:all": "pnpm --filter @aoda/ui build && pnpm --filter @aoda/ui build-storybook && pnpm --filter demo build",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=18"
  }
}
